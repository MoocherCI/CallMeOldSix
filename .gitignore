# Auto-generated .gitignore
# Environment variables and secrets
.env
.env.*
*.key
*.pem

# Logs
logs/
*.log

# Dependencies
node_modules/
__pycache__/

# Package manager cache (generated by npx wrangler deploy)
package-manager-cache/

# Session metadata (managed by app)
.cuneim/*
*/.cuneim/*
!*/.cuneim/targets.json
!.cuneim/targets.json
